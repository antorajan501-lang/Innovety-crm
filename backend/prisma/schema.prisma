datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPER_ADMIN
  TEAM_LEADER
  INTERN
  EMPLOYEE
}

enum TicketCategory {
  TECHNICAL
  PROJECT
  HR
  SOFTWARE
  HARDWARE
  GENERAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WAITING_FOR_REVIEW
  APPROVED
  REJECTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectType {
  CLIENT
  INTERNAL
  MAINTENANCE
  RND
  TRAINING
}

enum ProjectRole {
  PROJECT_LEADER
  TEAM_LEADER
  MEMBER
  OBSERVER
}

enum ChatRoomStatus {
  ACTIVE
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum WorkLogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  LEAVE
  WORK_FROM_HOME
  MISSED
}

model User {
  id               String           @id @default(uuid())
  employeeId       String           @unique // Auto-generated string (e.g. IN-1001)
  name             String
  email            String           @unique
  password         String
  phone            String?
  dob              DateTime?        // Date of birth
  college          String?
  department       String?
  joiningDate      DateTime         @default(now())
  role             Role             @default(INTERN)
  status           String           @default("ACTIVE") // ACTIVE, INACTIVE
  profilePic       String?          // File path/URL
  candidateType    String?          // Student, Graduate, Intern, Fresher, Professional
  resume           String?          // File path/URL for PDF/DOC/DOCX
  degree           String?
  currentYearSemester String?
  graduationYear   String?
  internshipRole   String?
  internshipDuration String?
  highestQualification String?
  keySkills        String?
  companyName      String?
  designation      String?
  totalExperience  String?
  notificationPreferences Json?
  customData              Json?
  casualLeaveQuota        Int              @default(12)
  sickLeaveQuota          Int              @default(12)
  emergencyLeaveQuota     Int              @default(6)
  resetOtpHash            String?
  resetOtpExpiry          DateTime?
  resetOtpAttempts        Int              @default(0)
  lastOtpSentAt           DateTime?
  resetTokenHash          String?
  resetTokenExpiry        DateTime?
  otpHourlyCount          Int              @default(0)
  otpHourlyWindowStart    DateTime?
  createdAt               DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  ledTeams         Team[]           @relation("TeamLeader")
  teamMembers      TeamMember[]
  attendances      Attendance[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  submissions      TaskSubmission[]
  raisedTickets    Ticket[]         @relation("TicketCreator")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  announcements          Announcement[]   @relation("AnnouncementCreator")
  receivedAnnouncements  Announcement[]   @relation("AnnouncementTargetUser")
  notifications          Notification[]
  activityLogs     ActivityLog[]
  comments         Comment[]
  leaves           LeaveRequest[]   @relation("UserLeaves")
  assignedAssets        Asset[]           @relation("UserAssignedAssets")
  assetAssignmentHistory AssetAssignment[] @relation("UserAssignmentHistory")
  assetAssignedByHistory AssetAssignment[] @relation("UserAssignedByHistory")
  chatMemberships        ChatRoomMember[]
  sentChatMessages       ChatMessage[]     @relation("ChatSender")
  messageReads           MessageRead[]

  // Project Relations
  createdProjects          Project[]         @relation("ProjectCreator")
  ledProjects              Project[]         @relation("ProjectLeader")
  projectMemberships       ProjectMember[]
  uploadedProjectDocuments ProjectDocument[]
  projectHistory           ProjectHistory[]  @relation("ProjectHistoryUser")
  workLogs                 WorkLog[]
  aiFeedbacks              AIFeedback[]
  createdFormVersions      CustomFormVersion[]
  performedBuilderHistory  BuilderHistory[]
  salaryStructure          SalaryStructure?  @relation("UserSalaryStructure")
  salaryRevisions          SalaryRevision[]  @relation("UserSalaryRevisions")
  performedRevisions       SalaryRevision[]  @relation("RevisedByRevisions")
  payslips                 Payslip[]         @relation("UserPayslips")
  processedBatches         PayrollBatch[]    @relation("ProcessedBatches")
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  leaderId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  leader        User?          @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  tasks         Task[]
  announcements Announcement[]
  chatRooms     ChatRoom[]
  projects      Project[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  joinedAt  DateTime @default(now())

  // Relations
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Attendance {
  id               String           @id @default(uuid())
  userId           String
  date             DateTime         @db.Date
  clockIn          DateTime
  clockOut     DateTime?
  clockInLocation  String?
  clockOutLocation String?
  ipAddress    String?
  browser      String?
  device       String?
  workingHours Float?           // Decimals representing decimal hours
  status       AttendanceStatus @default(PRESENT)
  editedBy     String?          // User ID who edited attendance
  lateMinutes     Int?
  earlyWindowUsed Int?
  gracePeriodUsed Int?
  shiftStartUsed  String?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  deadline    DateTime
  teamId      String?
  assigneeId  String
  creatorId   String
  attachments String[]     // List of file paths
  type        String?      @default("TASK") // TASK, BUG, STORY
  storyPoints Int?         @default(0)
  sprintName     String?
  projectId      String?
  milestoneId    String?
  estimatedHours Float?          @default(0)
  actualHours    Float?          @default(0)
  approvalStatus ApprovalStatus  @default(NOT_REQUIRED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  team           Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee       User              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator        User              @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  submissions    TaskSubmission[]
  comments       Comment[]
  history        TaskHistory[]
  subtasks       Subtask[]
  chatRooms      ChatRoom[]
  dependents     TaskDependency[]  @relation("TaskDependents")
  prerequisites  TaskDependency[]  @relation("TaskPrerequisites")
  workLogs       WorkLog[]
}

model TaskSubmission {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  submitNotes String?
  files       String[] // File paths/URLs uploaded by intern
  submittedAt DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId      String
  userId      String
  action      String   // "STATUS_CHANGE", "ASSIGNED", "EDITED", "SUBMITTED", "COMMENT"
  detail      String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  DAMAGED
  DISPOSED
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  MOBILE
  KEYBOARD
  MOUSE
  HEADSET
  TABLET
  PRINTER
  NETWORK
  FURNITURE
  OTHER
}

model Asset {
  id             String          @id @default(uuid())
  assetId        String          @unique // Auto-generated e.g. AST-1001
  name           String
  category       AssetCategory   @default(LAPTOP)
  brand          String?
  model          String?
  serialNumber   String?         @unique
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  cost           Float?
  vendor         String?
  location       String?
  billPhoto      String?         // File path / URL for bill/invoice photocopy
  status         AssetStatus     @default(AVAILABLE)
  description    String?
  
  // Current assignment snapshot / relation
  assignedToId   String?
  assignedTo     User?           @relation("UserAssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedDate   DateTime?
  expectedReturn DateTime?
  notes          String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relationships
  assignments    AssetAssignment[]
  tickets        Ticket[]
}

model AssetAssignment {
  id             String      @id @default(uuid())
  assetId        String
  userId         String
  assignedById   String?
  assignedDate   DateTime    @default(now())
  expectedReturn DateTime?
  returnDate     DateTime?
  conditionOnReturn String?   // Good, Damaged, Lost, Needs Repair
  remarks        String?
  notes          String?
  status         String      @default("ACTIVE") // ACTIVE, RETURNED

  asset          Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user           User        @relation("UserAssignmentHistory", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User?       @relation("UserAssignedByHistory", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  category    TicketCategory
  status      TicketStatus   @default(OPEN)
  creatorId   String
  assigneeId  String?
  assetId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator     User           @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model Announcement {
  id           String   @id @default(uuid())
  title        String
  content      String
  creatorId    String
  targetType   String   @default("ALL") // "ALL", "TEAM", "INDIVIDUAL"
  targetTeamId String?
  targetUserId String?
  createdAt    DateTime @default(now())

  creator      User     @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  targetTeam   Team?    @relation(fields: [targetTeamId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AnnouncementTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // "TASK_ASSIGNED", "TASK_APPROVED", "TICKET_CREATED", etc.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // LOGIN, CLOCK_IN, TASK_CREATE, etc.
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id               String   @id @default("GLOBAL")
  companyName      String   @default("Innoveity")
  senderEmail      String   @default("no-reply@innoveity.com")
  internShiftStart String   @default("09:30") // Format HH:MM
  internShiftEnd   String   @default("18:30")
  tlShiftStart     String   @default("09:30")
  tlShiftEnd       String   @default("18:30")
  officeLatitude   Float    @default(12.971598)
  officeLongitude  Float    @default(77.594562)
  allowedRadiusMeters Float  @default(200.0)
  officeLocationName  String @default("Innoveity Headquarters")
  earlyWindowMinutes Int    @default(30)
  gracePeriodMinutes Int    @default(15)
  updatedAt        DateTime @updatedAt
}

model PlatformSettings {
  id            String   @id @default("PLATFORM")
  companyName   String   @default("Innoviety Enterprise")
  companyLogo   String?
  selectedTheme String   @default("emerald")
  themeMode     String   @default("light")
  updatedAt     DateTime @updatedAt
}

model Subtask {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Repository {
  id           String   @id @default(uuid())
  name         String   @unique
  url          String?
  status       String   @default("Passing") // Passing, Failed, Building
  lang         String   @default("React/JS")
  commitsCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches     Branch[]
}

model LeaveRequest {
  id                  String   @id @default(uuid())
  userId              String
  startDate           DateTime
  endDate             DateTime
  totalDays           Float    @default(1.0)
  leaveType           String   @default("CASUAL") // CASUAL, SICK, EMERGENCY, WFH
  type                String   @default("LEAVE")   // LEAVE, WFH
  subject             String?
  letterContent       String?
  reason              String
  contactPhone        String?
  
  // Team Snapshot at submission time
  submittedTeamId       String?
  submittedTeamLeaderId String?

  // Status Workflow
  status              String   @default("PENDING_TL_APPROVAL") // PENDING_TL_APPROVAL, PENDING_ADMIN_APPROVAL, APPROVED, REJECTED, CANCELLED

  // Step 1: Team Leader Review
  tlApprovalStatus    String   @default("PENDING") // PENDING, APPROVED, REJECTED, NOT_REQUIRED
  tlApprovedById      String?
  tlApprovedAt        DateTime?
  tlRemarks           String?

  // Step 2: Admin Final Sanction
  adminApprovalStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminApprovedById   String?
  adminApprovedAt     DateTime?
  adminRemarks        String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id           String     @id @default(uuid())
  repoId       String
  name         String
  url          String?
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  repository   Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, name])
}

enum ChatRoomType {
  GLOBAL
  COMPANY
  TEAM
  PROJECT
  DIRECT
}

enum ChatMessageType {
  TEXT
  FILE
  IMAGE
}

model ChatRoom {
  id             String           @id @default(uuid())
  name           String?
  type           ChatRoomType     @default(DIRECT)
  teamId         String?
  taskId         String?
  projectId      String?          @unique
  status         ChatRoomStatus   @default(ACTIVE)
  lastMessageId  String?
  isDefault      Boolean          @default(false)
  isArchived     Boolean          @default(false)
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  members        ChatRoomMember[]
  messages       ChatMessage[]
}

model Project {
  id                 String          @id @default(uuid())
  projectCode        String          @unique // e.g. PRJ-1001
  name               String
  description        String?
  type               ProjectType     @default(CLIENT)
  status             ProjectStatus   @default(DRAFT)
  priority           ProjectPriority @default(MEDIUM)
  
  estimatedStartDate DateTime
  estimatedEndDate   DateTime
  actualStartDate    DateTime?
  actualEndDate      DateTime?

  teamId             String?
  creatorId          String
  leaderId           String?

  isDeleted          Boolean         @default(false)
  deletedAt          DateTime?
  deletedById        String?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  creator            User            @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  leader             User?           @relation("ProjectLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  team               Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members            ProjectMember[]
  documents          ProjectDocument[]
  chatRoom           ChatRoom?
  tasks              Task[]
  milestones         ProjectMilestone[]
  history            ProjectHistory[]
  workLogs           WorkLog[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model TaskDependency {
  id               String   @id @default(uuid())
  taskId           String   // The task that depends on another
  dependsOnTaskId  String   // The prerequisite task that must be completed first
  createdAt        DateTime @default(now())

  task             Task     @relation("TaskDependents", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask    Task     @relation("TaskPrerequisites", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model WorkLog {
  id           String        @id @default(uuid())
  projectId    String?
  taskId       String?
  userId       String
  description  String
  hoursWorked  Float
  workDate     DateTime      @default(now())
  status       WorkLogStatus @default(APPROVED)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIFeedback {
  id               String   @id @default(uuid())
  userId           String
  recommendationId String
  rating           String   // HELPFUL or NOT_HELPFUL
  category         String?
  feedbackText     String?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id         String   @id @default(uuid())
  projectId  String
  uploaderId String
  name       String
  fileUrl    String
  fileType   String?
  fileSize   Int?
  uploadedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model ProjectHistory {
  id          String         @id @default(uuid())
  projectId   String
  changedById String
  action      String         // e.g. "CREATED", "STATUS_CHANGE", "PRIORITY_CHANGE", "MEMBER_ADDED", etc.
  oldStatus   ProjectStatus?
  newStatus   ProjectStatus?
  detail      String
  createdAt   DateTime       @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("ProjectHistoryUser", fields: [changedById], references: [id], onDelete: Cascade)
}

model ChatRoomMember {
  id         String   @id @default(uuid())
  roomId     String
  userId     String
  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatMessage {
  id               String          @id @default(uuid())
  roomId           String
  senderId         String
  message          String
  messageType      ChatMessageType @default(TEXT)
  attachmentUrl    String?
  fileName         String?
  fileSize         Int?
  
  // Reply feature
  replyToMessageId String?
  replyTo          ChatMessage?    @relation("ReplyMessage", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]   @relation("ReplyMessage")

  // Edit feature
  isEdited         Boolean         @default(false)
  editedAt         DateTime?
  editedBy         String?

  // Soft Delete feature
  isDeleted        Boolean         @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  deletedForUsers  String?

  // Pin feature
  isPinned         Boolean         @default(false)
  pinnedAt         DateTime?
  pinnedById       String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  room             ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender           User            @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  reads            MessageRead[]
}

model MessageRead {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

enum FieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  TIME
  DATETIME
  DROPDOWN
  MULTISELECT
  CHECKBOX
  RADIO
  FILE
  IMAGE
  URL
  PASSWORD
  COLOR
  RATING
  SWITCH
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlatformEntityType {
  USER_PROFILE
  INTERN_PROFILE
  EMPLOYEE_PROFILE
  TEAM_LEADER_PROFILE
  ADMIN_PROFILE
  REGISTRATION
  PROJECT
  TASK
  ATTENDANCE
  LEAVE
  HELPDESK
  ANNOUNCEMENT
  ASSET
  WORKLOG
  TEAM
  CLIENT
}

model CustomFormField {
  id                 String             @id @default(uuid())
  entityType         PlatformEntityType
  fieldKey           String
  label              String
  placeholder        String?
  fieldType          FieldType          @default(TEXT)
  options            Json?              // Array of string options
  visibleTo          Json               // Array of roles
  editableBy         Json               // Array of roles
  requiredFor        Json               // Array of roles

  // Dynamic Validation Rules
  minLength          Int?
  maxLength          Int?
  minVal             Float?
  maxVal             Float?
  regexPattern       String?
  defaultValue       String?
  isUnique           Boolean            @default(false)
  isReadOnly         Boolean            @default(false)
  isHidden           Boolean            @default(false)
  isDisabled         Boolean            @default(false)

  // Conditional Visibility Rules
  dependsOnField     String?
  dependsOnOperator  String?            // EQUALS, NOT_EQUALS, CONTAINS, GREATER_THAN, LESS_THAN, IN, IS_NOT_EMPTY
  dependsOnValue     String?

  isSystemDefault    Boolean            @default(false)
  order              Int                @default(0)
  versionId          String?
  version            CustomFormVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([entityType, fieldKey, versionId])
}

model CustomFormVersion {
  id          String             @id @default(uuid())
  entityType  PlatformEntityType
  version     Int                @default(1)
  status      FormStatus         @default(DRAFT)
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  fields      CustomFormField[]
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([entityType, version])
}

model DynamicMenu {
  id         String        @id @default(uuid())
  role       Role
  menuKey    String
  label      String
  icon       String?
  route      String
  permission String?
  badge      String?
  order      Int           @default(0)
  isVisible  Boolean       @default(true)
  parentId   String?
  parent     DynamicMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   DynamicMenu[] @relation("MenuHierarchy")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([role, menuKey])
}

model BuilderHistory {
  id            String              @id @default(uuid())
  performedById String
  performedBy   User                @relation(fields: [performedById], references: [id])
  builderType   String              // FORM, MENU
  entityType    PlatformEntityType?
  action        String              // SAVE_DRAFT, PUBLISH, ROLLBACK
  oldSnapshot   Json?
  newSnapshot   Json?
  details       String
  createdAt     DateTime            @default(now())
}

enum PayrollBatchStatus {
  DRAFT
  PREVIEW
  LOCKED
  REVIEW
  PUBLISHED
  COMPLETED
  ROLLED_BACK
}

enum HolidayType {
  NATIONAL
  COMPANY
  WEEKEND
}

model SalaryTemplate {
  id               String            @id @default(uuid())
  name             String            @unique // e.g. "Default Employee", "Senior Employee", "Manager", "Intern Stipend"
  description      String?
  targetRole       Role              @default(EMPLOYEE)
  basicSalary      Float             @default(0)
  hra              Float             @default(0)
  da               Float             @default(0)
  specialAllowance Float             @default(0)
  travelAllowance  Float             @default(0)
  medicalAllowance Float             @default(0)
  otherAllowances  Float             @default(0)
  bonus            Float             @default(0)
  
  pfRatePercent    Float             @default(12.0)
  esiRatePercent   Float             @default(0.75)
  profTax          Float             @default(200.0)
  incomeTaxPercent Float             @default(5.0)
  otherDeductions  Float             @default(0)
  
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  structures       SalaryStructure[]
}

model SalaryStructure {
  id               String          @id @default(uuid())
  userId           String          @unique
  templateId       String?
  
  basicSalary      Float           @default(0)
  hra              Float           @default(0)
  da               Float           @default(0)
  specialAllowance Float           @default(0)
  travelAllowance  Float           @default(0)
  medicalAllowance Float           @default(0)
  otherAllowances  Float           @default(0)
  bonus            Float           @default(0)
  
  pfDeduction      Float           @default(0)
  esiDeduction     Float           @default(0)
  profTax          Float           @default(200.0)
  incomeTax        Float           @default(0)
  otherDeductions  Float           @default(0)
  
  grossSalary      Float           @default(0)
  netSalary        Float           @default(0)
  
  effectiveFrom    DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation("UserSalaryStructure", fields: [userId], references: [id], onDelete: Cascade)
  template         SalaryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model SalaryRevision {
  id             String   @id @default(uuid())
  userId         String
  previousSalary Float
  newSalary      Float
  revisionType   String   // PROMOTION, INCREMENT, REGULAR
  changeAmount   Float
  effectiveDate  DateTime @default(now())
  reason         String
  revisedById    String
  createdAt      DateTime @default(now())

  user           User     @relation("UserSalaryRevisions", fields: [userId], references: [id], onDelete: Cascade)
  revisedBy      User     @relation("RevisedByRevisions", fields: [revisedById], references: [id], onDelete: Cascade)
}

model HolidayCalendar {
  id               String      @id @default(uuid())
  title            String
  date             DateTime    @unique @db.Date
  type             HolidayType @default(COMPANY)
  isWorkingHoliday Boolean     @default(false)
  payMultiplier    Float       @default(2.0) // 2.0x for Holiday, 1.5x for Weekend
  remarks          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model PayrollSettings {
  id                    String   @id @default("GLOBAL")
  cycleStartDay         Int      @default(1)
  payDay                Int      @default(30)
  currency              String   @default("INR")
  overtimeHourlyRate    Float    @default(150.0)
  holidayPayMultiplier  Float    @default(2.0)
  weekendPayMultiplier  Float    @default(1.5)
  lateDeductionRule     String   @default("FLAT_RATE") // FLAT_RATE, PERCENTAGE
  lateDeductionRate     Float    @default(100.0)
  halfDayDeductionRate  Float    @default(0.5)
  minimumWorkingHours   Float    @default(4.0)
  roundingRule          String   @default("ROUND_HALF_UP")
  payslipTemplate       String   @default("STANDARD")
  companyName           String   @default("Innoveity")
  companyLogo           String?
  companyAddress        String   @default("100 Innovation Towers, Cyber City, Bangalore - 560001")
  authorizedSignature   String   @default("Authorized HR Signatory")
  updatedAt             DateTime @updatedAt
}

model PayrollBatch {
  id              String             @id @default(uuid())
  month           Int                // 1 to 12
  year            Int                // e.g. 2026
  status          PayrollBatchStatus @default(DRAFT)
  totalEmployees  Int                @default(0)
  totalGross      Float              @default(0)
  totalDeductions Float              @default(0)
  totalNet        Float              @default(0)
  processedById   String
  lockedAt        DateTime?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  processedBy     User               @relation("ProcessedBatches", fields: [processedById], references: [id], onDelete: Cascade)
  payslips        Payslip[]

  @@unique([month, year])
}

model Payslip {
  id                 String             @id @default(uuid())
  batchId            String
  userId             String
  month              Int
  year               Int
  
  basicSalary        Float              @default(0)
  hra                Float              @default(0)
  da                 Float              @default(0)
  allowancesJson     Json?              // Itemized allowances
  deductionsJson     Json?              // Itemized deductions
  grossSalary        Float              @default(0)
  netSalary          Float              @default(0)
  
  workingDays        Int                @default(30)
  presentDays        Float              @default(0)
  paidLeaveDays      Float              @default(0)
  unpaidAbsentDays   Float              @default(0)
  wfhDays            Float              @default(0)
  overtimeHours      Float              @default(0)
  overtimePay        Float              @default(0)
  holidayDaysWorked  Float              @default(0)
  holidayPay         Float              @default(0)
  lateDeduction      Float              @default(0)

  status             PayrollBatchStatus @default(DRAFT)
  qrCodeHash         String?
  pdfPath            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  batch              PayrollBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user               User               @relation("UserPayslips", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([batchId, userId])
}


